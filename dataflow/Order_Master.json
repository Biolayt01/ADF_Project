{
	"name": "Order_Master",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Order_source",
						"type": "DatasetReference"
					},
					"name": "ordersource"
				},
				{
					"dataset": {
						"referenceName": "order_details",
						"type": "DatasetReference"
					},
					"name": "orderDetails"
				},
				{
					"dataset": {
						"referenceName": "customer_tbl",
						"type": "DatasetReference"
					},
					"name": "customer"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "destination_data",
						"type": "DatasetReference"
					},
					"name": "destination"
				}
			],
			"transformations": [
				{
					"name": "Orders"
				},
				{
					"name": "selectedColumns"
				},
				{
					"name": "custOrder"
				},
				{
					"name": "correctDataType",
					"description": "Autogenerated by data preview actions"
				},
				{
					"name": "orderIDsorting"
				}
			],
			"scriptLines": [
				"source(output(",
				"          orderID as integer,",
				"          customerID as string,",
				"          employeeID as string,",
				"          orderDate as string,",
				"          requiredDate as string,",
				"          shippedDate as string,",
				"          shipVia as string,",
				"          freight as string,",
				"          shipName as string,",
				"          shipAddress as string,",
				"          shipCity as string,",
				"          shipRegion as string,",
				"          shipPostalCode as string,",
				"          shipCountry as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> ordersource",
				"source(output(",
				"          orderID as integer,",
				"          productID as string,",
				"          unitPrice as string,",
				"          quantity as string,",
				"          discount as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     limit: 10,",
				"     ignoreNoFilesFound: false) ~> orderDetails",
				"source(output(",
				"          customerID as string,",
				"          companyName as string,",
				"          contactName as string,",
				"          contactTitle as string,",
				"          address as string,",
				"          city as string,",
				"          region as string,",
				"          postalCode as string,",
				"          country as string,",
				"          phone as string,",
				"          fax as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> customer",
				"ordersource, orderDetails join(ordersource@orderID == orderDetails@orderID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> Orders",
				"custOrder select(mapColumn(",
				"          orderID = ordersource@orderID,",
				"          customerID = ordersource@customerID,",
				"          employeeID,",
				"          orderDate,",
				"          requiredDate,",
				"          shippedDate,",
				"          shipVia,",
				"          freight,",
				"          shipName,",
				"          shipAddress,",
				"          shipCity,",
				"          shipRegion,",
				"          shipCountry,",
				"          productID,",
				"          unitPrice,",
				"          quantity,",
				"          discount,",
				"          companyName,",
				"          contactName,",
				"          city,",
				"          region,",
				"          phone",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectedColumns",
				"Orders, customer join(ordersource@customerID == customer@customerID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> custOrder",
				"selectedColumns derive(employeeID = toInteger(employeeID),",
				"          shipVia = toInteger(shipVia),",
				"          freight = toFloat(freight),",
				"          productID = toInteger(productID),",
				"          unitPrice = toFloat(unitPrice),",
				"          quantity = toInteger(quantity),",
				"          discount = toFloat(discount),",
				"          orderDate = toDate(orderDate,'yyyy-MM-dd'),",
				"          shippedDate = toDate(shippedDate,'yyyy-MM-dd'),",
				"          requiredDate = toDate(requiredDate,'yyyy-MM-dd')) ~> correctDataType",
				"correctDataType sort(asc(orderID, true)) ~> orderIDsorting",
				"orderIDsorting sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['Order_Master'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> destination"
			]
		}
	}
}