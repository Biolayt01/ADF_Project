						"     ignoreNoFilesFound: false) ~> orderDetails",
						"source(output(",
						"          customerID as string,",
						"          companyName as string,",
						"          contactName as string,",
						"          contactTitle as string,",
						"          address as string,",
						"          city as string,",
						"          region as string,",
