						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> ordersource",
						"source(output(",
						"          orderID as integer,",
						"          productID as string,",
						"          unitPrice as string,",
						"          quantity as string,",
						"          discount as string",
						"     ),",
						"     allowSchemaDrift: true,",
